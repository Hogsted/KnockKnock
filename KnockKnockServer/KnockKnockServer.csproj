<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kopieres til output-mappen, så en ny vittighed kan tilføjes uden at genkompilere -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="KnockKnockServer.Tests" />
  </ItemGroup>

</Project>
